# ds-api-proxy environment configuration
# Copy to .env and fill in the required values.
#   cp .env.example .env
#
# All variables are parsed centrally in lib/config.js.

# --- Required ---------------------------------------------------------------

# Upstream DeepSeek host, e.g. chat.deepseek.com.
# The server exits at startup if this is unset.
DS_REMOTE_HOST=chat.deepseek.com

# DS auth config: a directory of *.json files.
# Each file: { "token": "...", "cookie": "...", "wasmUrl": "..." }
DS_AUTH_DIR=./.auth

# --- Server -----------------------------------------------------------------

# HTTP listen port (1-65535).
PORT=9876

# HTTP listen host.
HOST=127.0.0.1

# --- Concurrency & recovery -------------------------------------------------

# Max simultaneous in-flight completions.
DS_MAX_CONCURRENT=24

# Per-request deadline in ms before recovery gives up.
DS_REQUEST_DEADLINE_MS=120000

# Empty-response retries per account (0-10).
DS_MAX_RETRIES=2

# Same-account retries when DS reports a transient upstream outage
# (finish_reason=generation_err / "Server temporarily unavailable."). Rotating
# accounts cannot help here (all accounts share the same upstream), so the
# proxy retries the current account instead of penalising it (0-10).
DS_MAX_UPSTREAM_RETRIES=3

# Max auto-continuation rounds for long / length-finished responses (0-10).
DS_MAX_CONTINUATION=2

# Max rounds to turn a reasoning-only response (thinking but no final text)
# into a visible final answer, so the client is not left needing a manual continue (0-10).
DS_MAX_REASONING_CONTINUATION=2

# Max completion rounds for truncated tool-call markup (0-10).
DS_MAX_MARKUP_COMPLETION=2

# Response length (chars) above which auto-continuation kicks in.
DS_CONTINUATION_SIZE_THRESHOLD=25000

# Base delay in ms between recovery retries (scaled, capped at 3x).
DS_RECOVERY_RETRY_DELAY_MS=500

# Cooldown in ms after malformed tool-call markup.
DS_MALFORMED_TOOL_CALL_COOLDOWN_MS=5000

# Consecutive remote-session recreations on the SAME account (to recover from
# malformed tool-call markup) before that account is rotated.
DS_MAX_SESSION_RESETS_PER_ACCOUNT=3

# --- Accounts ---------------------------------------------------------------

# Cooldown in ms after an HTTP 401/403/429 account failure (10 min).
DS_ACCOUNT_COOLDOWN_MS=600000

# Default client identity sent upstream. Accounts in other regions can override
# these per file with "locale" / "timezone_offset" fields in their auth JSON.
DS_CLIENT_LOCALE=en
DS_CLIENT_TIMEZONE_OFFSET=0

# --- Sessions ---------------------------------------------------------------

# Remote session TTL in ms before rollover (2 h).
DS_SESSION_TTL_MS=7200000

# Max concurrent agent sessions.
DS_MAX_SESSIONS=1000

# Interval in ms between idle-session / stale-upload sweeps (10 min).
DS_SESSION_SWEEP_INTERVAL_MS=600000

# --- Uploads ----------------------------------------------------------------

# Upload cache TTL in ms (6 h).
DS_UPLOAD_CACHE_TTL_MS=21600000

# Max size in bytes of a single uploaded attachment (25 MB).
DS_MAX_UPLOAD_BYTES=26214400

# --- Upstream networking ----------------------------------------------------

# Timeout in ms for DeepSeek fetch calls.
DS_FETCH_TIMEOUT_MS=60000

# Interval in ms when polling uploaded file status.
DS_FILE_POLL_INTERVAL_MS=1000

# Timeout in ms waiting for an uploaded file to become SUCCESS.
DS_FILE_POLL_TIMEOUT_MS=60000

# --- Request body -----------------------------------------------------------

# Max size in bytes of an incoming request body (10 MB).
DS_MAX_BODY_BYTES=10485760
DS_BODY_READ_TIMEOUT_MS=30000
DS_HEADERS_TIMEOUT_MS=60000
DS_REQUEST_TIMEOUT_MS=300000

# --- CORS -------------------------------------------------------------------

# Comma-separated allowlist of browser origins allowed to call the proxy.
# Empty (default) reflects the request Origin (fine for a localhost proxy).
# Set this when binding HOST to a public interface to avoid CSRF.
# DS_ALLOWED_ORIGINS=https://app.example,https://admin.example

# --- Streaming --------------------------------------------------------------

# SSE keep-alive comment-frame interval in ms while an upstream request is in
# flight. 0 disables heartbeats.
# DS_STREAM_KEEPALIVE_MS=15000

# --- Shutdown ---------------------------------------------------------------

# Grace period in ms to let in-flight requests finish on SIGTERM/SIGINT
# before forcing connections closed.
# DS_SHUTDOWN_GRACE_MS=15000

# --- Debug ------------------------------------------------------------------

# Set to 1 for verbose debug logging.
# DS_DEBUG=1

# Set to 1 to dump every raw upstream SSE `data:` line plus a final path
# histogram (diagnostic; to learn how DS currently frames its stream).
# DS_DUMP_SSE=1

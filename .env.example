# ds-api-proxy environment configuration
# Reference of every supported variable and its default. Nothing here is
# required: .env is optional and real environment variables always win.
# Copy only the lines you actually need to override into .env, e.g.
#   echo "PORT=8080" >> .env
#
# All variables are parsed centrally in lib/config.js.

# --- Auth accounts ----------------------------------------------------------

# DS auth config: a directory of *.json files. Defaults to ./.auth when unset.
# Each file: { "token": "...", "cookie": "...", "wasmUrl": "..." }
# DS_AUTH_DIR=./.auth

# --- Server -----------------------------------------------------------------

# HTTP listen port (1-65535).
# PORT=9876

# HTTP listen host.
# HOST=127.0.0.1

# --- Request body & timeouts ------------------------------------------------

# Max size in bytes of an incoming request body (10 MB).
# DS_MAX_BODY_BYTES=10485760

# Max time in ms to receive a full request body before returning 408.
# DS_BODY_READ_TIMEOUT_MS=30000

# Socket-level timeouts in ms.
# DS_HEADERS_TIMEOUT_MS=60000
# DS_REQUEST_TIMEOUT_MS=300000

# --- Concurrency & deadlines ------------------------------------------------

# Max simultaneous in-flight completions (1-256).
# DS_MAX_CONCURRENT=10

# Per-request deadline in ms before recovery gives up.
# DS_REQUEST_DEADLINE_MS=120000

# Total wall-clock budget (ms) for cycling through accounts after failures,
# so a request does not spend its whole DS_REQUEST_DEADLINE_MS waiting out
# cooldowns on every account.
# DS_ROTATION_BUDGET_MS=60000

# --- Accounts ---------------------------------------------------------------

# Cooldown in ms after an HTTP 401/403/429 account failure (5 min).
# DS_ACCOUNT_COOLDOWN_MS=300000

# Minimum spacing in ms between two chat completions sent to the SAME account.
# The upstream limit is per-frequency: a burst of back-to-back completions
# (several agents sharing one sticky account) can trip it. Before each
# completion the proxy waits until this much time has elapsed since that
# account's previous completion, then solves the PoW challenge and sends the
# request. Set to 0 to disable.
# DS_ACCOUNT_MIN_COMPLETION_INTERVAL_MS=6000

# How often per-account runtime state (cooldowns + LRU lastUsedAt) is flushed
# to $DS_AUTH_DIR/.account-state.json. Both are only marked dirty on change and
# written together on this interval, so the request path does no disk I/O. Set
# to 0 to disable persistence entirely.
# DS_ACCOUNT_STATE_FLUSH_MS=60000

# Default client identity sent upstream. Accounts in other regions can override
# these per file with "locale" / "timezone_offset" fields in their auth JSON.
# DS_CLIENT_LOCALE=en
# DS_CLIENT_TIMEZONE_OFFSET=0

# --- Sessions & agent identity ----------------------------------------------

# Idle TTL in ms: roll a remote session over only after this long WITHOUT
# conversation activity. An actively-used session is never reset on age alone.
# Independently, a shorter `messages` array than the previous request (a
# /compact summary replacing the history) resets the remote session at once.
# DS_SESSION_TTL_MS=7200000

# Max concurrent agent sessions.
# DS_MAX_SESSIONS=1000

# Interval in ms between idle-session / stale-upload sweeps (10 min).
# DS_SESSION_SWEEP_INTERVAL_MS=600000

# When set to 1, force every request into ephemeral anonymous mode: all
# session-id headers/body fields (x-agent-session / x-session-affinity /
# x-session-id / session_id / x-client-request-id / body session|user) are
# ignored and each call gets a unique throwaway session, even from agents that
# do send a session identifier. Off by default (session headers are honored).
# DS_IGNORE_AGENT_SESSION=0

# --- Recovery ---------------------------------------------------------------

# Same-account retries when DS reports a transient upstream outage
# (finish_reason=generation_err / "Server temporarily unavailable."). Rotating
# accounts cannot help here (all accounts share the same upstream), so the
# proxy retries the current account instead of penalising it (0-10).
# DS_MAX_UPSTREAM_RETRIES=3

# Max auto-continuation rounds for long / length-finished responses (0-10).
# DS_MAX_CONTINUATION=2

# Max rounds to turn a reasoning-only response (thinking but no final text)
# into a visible final answer, so the client is not left needing a manual continue (0-10).
# DS_MAX_REASONING_CONTINUATION=2

# Max rounds to turn a short "action promise" (reasoning + a brief line like
# "Let me check the tests" with finish_reason=stop and no tool call) into the
# actual tool call or a real final answer. Without this the client is stranded
# until a manual continue. 0 disables the phase (0-10).
# DS_MAX_ACTION_PROMISE_CONTINUATION=1

# Max content length (chars) for the action-promise phase: a longer body is a
# real answer, not a promise to act.
# DS_ACTION_PROMISE_MAX_CHARS=600

# Corrective retries when the model asks for a tool that is not in the
# request's tools list. Deterministic, so it does not rotate the account (0-10).
# DS_MAX_UNKNOWN_TOOL_RETRIES=1

# Base delay in ms between recovery retries (scaled, capped at 3x).
# DS_RECOVERY_RETRY_DELAY_MS=500

# --- Adaptive throttle & response size --------------------------------------

# Adaptive per-account completion throttle by burn rate. Above this tokens/min
# the interval between completions on one account is stretched (0 disables).
# DS_TOKEN_RATE_LIMIT_PER_MIN=0

# Extra intervals a fully pressured session (burn >= 2x the limit above) waits.
# DS_TOKEN_RATE_BACKOFF_FACTOR=2

# Response length (chars) above which auto-continuation kicks in.
# DS_CONTINUATION_SIZE_THRESHOLD=25000

# Max response length in words, injected as a system-prompt instruction so the
# model keeps answers short. 0 disables the instruction.
# DS_MAX_RESPONSE_WORDS=500

# --- Uploads ----------------------------------------------------------------

# Upload cache TTL in ms (6 h).
# DS_UPLOAD_CACHE_TTL_MS=21600000

# Max size in bytes of a single uploaded attachment (25 MB).
# DS_MAX_UPLOAD_BYTES=26214400

# --- Upstream networking ----------------------------------------------------

# Timeout in ms for DeepSeek fetch calls. Applies to ancillary calls (PoW
# challenge, session create/delete, uploads); the completion stream itself is
# bounded by DS_REQUEST_DEADLINE_MS so long answers are not cut off mid-stream.
# DS_FETCH_TIMEOUT_MS=60000

# Interval in ms when polling uploaded file status.
# DS_FILE_POLL_INTERVAL_MS=1000

# Timeout in ms waiting for an uploaded file to become SUCCESS.
# DS_FILE_POLL_TIMEOUT_MS=60000

# --- Web search -------------------------------------------------------------

# Default value of the upstream `search_enabled` flag when the client does NOT
# send `web_search_options`. On (default) preserves the historical behaviour;
# set to 0 for strict OpenAI semantics (absent == off). An explicit
# web_search_options always forces search on regardless of this default.
# DS_DEFAULT_SEARCH_ENABLED=0

# --- CORS -------------------------------------------------------------------

# Comma-separated allowlist of browser origins allowed to call the proxy.
# Empty (default) reflects the request Origin (fine for a localhost proxy).
# Set this when binding HOST to a public interface to avoid CSRF.
# DS_ALLOWED_ORIGINS=https://app.example,https://admin.example

# --- Streaming --------------------------------------------------------------

# SSE keep-alive comment-frame interval in ms while an upstream request is in
# flight. 0 disables heartbeats.
# DS_STREAM_KEEPALIVE_MS=15000

# --- Shutdown ---------------------------------------------------------------

# Grace period in ms to let in-flight requests finish on SIGTERM/SIGINT
# before forcing connections closed.
# DS_SHUTDOWN_GRACE_MS=15000

# --- Auth helper (scripts/auth.js) ------------------------------------------
#
# Used by `npm run auth` (visible browser) and `npm run auth:headless`
# (`--headless`). The helper opens a disposable browser profile, lets you log
# in (or auto-fills credentials), and writes a token+cookie JSON into
# DS_AUTH_DIR. The browser is required because the login endpoint is guarded
# by an AWS WAF JS-challenge that cannot be solved over plain HTTP.

# Browser executable. Optional: when unset, common Chromium/Chrome locations
# are searched. Set this if your browser is elsewhere.
# CHROME_PATH=/usr/bin/chromium

# DevTools port for the disposable browser (1-65535).
# DS_AUTH_CDP_PORT=9339

# How long to wait for the sign-in form to render (ms).
# DS_LOGIN_FORM_TIMEOUT_MS=30000

# How long to wait for a successful login after submitting (ms).
# DS_LOGIN_TIMEOUT_MS=120000

# Set to 1 to keep the disposable browser profile after the helper exits.
# DS_KEEP_PROFILE=1

# --- Debug ------------------------------------------------------------------

# Set to 1 for verbose debug logging.
# DS_DEBUG=1

# Set to 1 to dump every raw upstream SSE `data:` line plus a final path
# histogram (diagnostic; to learn how DS currently frames its stream).
# DS_DUMP_SSE=1
